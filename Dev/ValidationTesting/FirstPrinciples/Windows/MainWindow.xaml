<Window
	x:Class="FirstPrinciples.Windows.MainWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:converters="clr-namespace:FirstPrinciples.Converters"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:local="clr-namespace:FirstPrinciples"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:vms="clr-namespace:FirstPrinciples.ViewModels"
	Title="Teams Maintenance"
	Width="800"
	Height="450"
	d:DataContext="{d:DesignInstance Type=vms:TeamViewModel}"
	mc:Ignorable="d">
	<Window.Resources>
		<BooleanToVisibilityConverter x:Key="BoolToVis" />
		<converters:InvertBoolToVisibilityConverter x:Key="InvertBoolToVisibility" />
	</Window.Resources>
	<DockPanel>
		<Grid Background="LightGray" DockPanel.Dock="Top">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="*" />
			</Grid.ColumnDefinitions>
			<Button
				Grid.Row="0"
				Grid.Column="0"
				Width="75"
				Command="{Binding ExitCommand}">
				E_xit
			</Button>
			<Button
				Grid.Row="0"
				Grid.Column="1"
				Width="75"
				Command="{Binding AddCommand}">
				_Add
			</Button>
			<Button
				Grid.Row="0"
				Grid.Column="2"
				Width="75"
				Command="{Binding SaveCommand}">
				_Save
			</Button>
			<Button
				Grid.Row="0"
				Grid.Column="3"
				Width="75"
				Command="{Binding DeleteCommand}">
				_Delete
			</Button>
			<Button
				Grid.Row="0"
				Grid.Column="4"
				Width="75"
				Command="{Binding HelpCommand}">
				_Help
			</Button>
		</Grid>

		<Grid DockPanel.Dock="Bottom">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>
			<Image
				Grid.Column="0"
				Height="30"
				Margin="5"
				Source="/Assets/Images/AtlasGoldGlobe.jpg" />
			<TextBlock
				Grid.Column="2"
				Margin="5"
				VerticalAlignment="Center">
				https://avantisystems.com/
			</TextBlock>
			<Image
				Grid.Column="3"
				Height="30"
				Margin="5"
				Source="/Assets/Images/Avanti.ARicohCompany.png"
				Stretch="Fill" />

		</Grid>

		<StackPanel Orientation="Horizontal">
			<Grid Width="250" Margin="10">
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="*" />
				</Grid.RowDefinitions>
				<TextBlock Grid.Row="0" FontWeight="Bold">Teams</TextBlock>
				<ListView
					Grid.Row="1"
					DisplayMemberPath="DisplayMember"
					ItemsSource="{Binding Teams, Mode=TwoWay}"
					SelectedItem="{Binding SelectedTeam}" />
			</Grid>

			<Grid Margin="10" DataContext="{Binding SelectedTeam}">
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="*" />
					<RowDefinition Height="Auto" />
				</Grid.RowDefinitions>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="Auto" MinWidth="200" />
					<ColumnDefinition Width="*" />
				</Grid.ColumnDefinitions>

				<StackPanel
					Grid.Row="0"
					Grid.Column="0"
					Grid.ColumnSpan="3"
					Orientation="Horizontal">
					<TextBlock Text="Select a team on the left to view info" Visibility="{Binding DataContext.IsTeamSelected, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}, Converter={StaticResource InvertBoolToVisibility}, ConverterParameter=Inverted}" />
					<TextBlock d:Text="Montereal Canadians (Habs)" Text="{Binding DisplayMember}" />
					<TextBlock Text="*" Visibility="{Binding DataContext.IsDirty, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}, Converter={StaticResource BoolToVis}}" />
				</StackPanel>

				<TextBlock
					Grid.Row="1"
					Grid.Column="0"
					Margin="5"
					HorizontalAlignment="Right"
					FontWeight="Bold">
					Team Name
				</TextBlock>
				<TextBox
					Grid.Row="1"
					Grid.Column="1"
					Margin="5"
					Text="{Binding TeamName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
				<Image
					Grid.Row="1"
					Grid.RowSpan="2"
					Grid.Column="2"
					MaxHeight="50"
					Margin="5"
					HorizontalAlignment="Left"
					d:Source="https://www.nhl.com/assets/icons/fav/teams/8/favicon.ico"
					Source="{Binding LogoUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

				<TextBlock
					Grid.Row="2"
					Grid.Column="0"
					Margin="5"
					HorizontalAlignment="Right"
					FontWeight="Bold">
					Nickname
				</TextBlock>
				<TextBox
					Grid.Row="2"
					Grid.Column="1"
					Margin="5"
					Text="{Binding Nickname, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

				<TextBlock
					Grid.Row="3"
					Grid.Column="0"
					Margin="5"
					HorizontalAlignment="Right"
					FontWeight="Bold">
					General Info
				</TextBlock>

				<TextBlock
					Grid.Row="4"
					Grid.Column="0"
					Margin="5"
					HorizontalAlignment="Right"
					FontWeight="Bold">
					Mascot
				</TextBlock>
				<TextBox
					Grid.Row="4"
					Grid.Column="1"
					Margin="5"
					Text="{Binding Mascot, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

				<TextBlock
					Grid.Row="5"
					Grid.Column="0"
					Margin="5"
					HorizontalAlignment="Right"
					FontWeight="Bold">
					Arena Name
				</TextBlock>
				<TextBox
					Grid.Row="5"
					Grid.Column="1"
					Margin="5"
					Text="{Binding ArenaName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

				<TextBlock
					Grid.Row="6"
					Grid.Column="0"
					Margin="5"
					HorizontalAlignment="Right"
					FontWeight="Bold">
					Inauguaral Year
				</TextBlock>
				<TextBox
					Grid.Row="6"
					Grid.Column="1"
					Margin="5"
					Text="{Binding InauguralYear, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

				<TextBlock
					Grid.Row="7"
					Grid.Column="0"
					Margin="5"
					HorizontalAlignment="Right"
					FontWeight="Bold">
					Website Url
				</TextBlock>
				<TextBox
					Grid.Row="7"
					Grid.Column="1"
					Margin="5"
					Text="{Binding WebsiteUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

				<TextBlock
					Grid.Row="8"
					Grid.Column="0"
					Margin="5"
					HorizontalAlignment="Right"
					FontWeight="Bold">
					Logo Url
				</TextBlock>
				<TextBox
					Grid.Row="8"
					Grid.Column="1"
					Margin="5"
					Text="{Binding LogoUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

				<TextBlock
					Grid.Row="10"
					Grid.Column="0"
					Margin="5"
					HorizontalAlignment="Left">
					<Run
						d:Text="99"
						FontStyle="Italic"
						Foreground="Gray"
						Text="{Binding Id, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
				</TextBlock>
			</Grid>
		</StackPanel>
	</DockPanel>
</Window>
