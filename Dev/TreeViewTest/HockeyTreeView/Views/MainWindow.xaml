<Window
	x:Class="HockeyTreeView.Views.MainWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:model="clr-namespace:HockeyTreeView.Models"
	Title="NhlHockeyLeague"
	Width="1000"
	Height="800"
	d:Height="500"
	mc:Ignorable="d">
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="Auto" />
			<ColumnDefinition Width="*" />
		</Grid.ColumnDefinitions>
		<TreeView
			x:Name="LeagueTreeView"
			Grid.Row="0"
			d:Width="300"
			ItemsSource="{Binding Leagues}"
			Loaded="LeagueTreeView_Loaded"
			SelectedItemChanged="LeagueTreeView_SelectedItemChanged">
			<!--  League Level  -->
			<TreeView.ItemTemplate>
				<HierarchicalDataTemplate ItemsSource="{Binding Conferences}">
					<StackPanel Orientation="Horizontal">
						<Image
							Width="50"
							Height="50"
							Source="{Binding LogoUri}" />
						<TextBlock VerticalAlignment="Center">
							<Run Text="{Binding Name}" />
							<Run Text=" (" />
							<Run Text="{Binding Nickname}" />
							<Run Text=")" />
						</TextBlock>
					</StackPanel>

					<!--  Conference Level  -->
					<HierarchicalDataTemplate.ItemTemplate>
						<HierarchicalDataTemplate ItemsSource="{Binding Divisions}">
							<StackPanel Orientation="Horizontal">
								<Image
									Width="50"
									Height="50"
									Source="{Binding LogoUri}" />
								<TextBlock VerticalAlignment="Center">
									<Run Text="{Binding Name}" />
									<Run Text=" (" />
									<Run Text="{Binding Nickname}" />
									<Run Text=")" />
								</TextBlock>
							</StackPanel>

							<!--  Division Level  -->
							<HierarchicalDataTemplate.ItemTemplate>
								<HierarchicalDataTemplate ItemsSource="{Binding Teams}">
									<StackPanel Orientation="Horizontal">
										<Image
											Width="50"
											Height="50"
											Source="{Binding LogoUri}" />
										<TextBlock VerticalAlignment="Center">
											<Run Text="{Binding Name}" />
											<Run Text=" (" />
											<Run Text="{Binding Nickname}" />
											<Run Text=")" />
										</TextBlock>
									</StackPanel>

									<!--  Team Level  -->
									<HierarchicalDataTemplate.ItemTemplate>
										<DataTemplate>
											<StackPanel Orientation="Horizontal">
												<Image
													Width="50"
													Height="50"
													Source="{Binding LogoUri}" />
												<TextBlock VerticalAlignment="Center">
													<Run Text="{Binding Name}" />
													<Run Text=" (" />
													<Run Text="{Binding Nickname}" />
													<Run Text=")" />
													<Run Text=" - " />
													<Run Text="{Binding ArenaName}" />
													<Run Text=" (" />
													<Run Text="{Binding CityName}" />
													<Run Text=")" />
												</TextBlock>
											</StackPanel>
										</DataTemplate>
									</HierarchicalDataTemplate.ItemTemplate>
								</HierarchicalDataTemplate>
							</HierarchicalDataTemplate.ItemTemplate>
						</HierarchicalDataTemplate>
					</HierarchicalDataTemplate.ItemTemplate>
				</HierarchicalDataTemplate>
			</TreeView.ItemTemplate>
		</TreeView>
		<Grid
			Grid.Column="1"
			Background="Beige"
			DataContext="{Binding SelectedTeam}">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="*" />
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="*" />
			</Grid.ColumnDefinitions>
			<Label
				Grid.Row="0"
				Grid.Column="0"
				Content="Name:" />
			<TextBox
				Grid.Row="0"
				Grid.Column="1"
				Text="{Binding Name}" />
			<Label
				Grid.Row="1"
				Grid.Column="0"
				Content="Nickname:" />
			<TextBox
				Grid.Row="1"
				Grid.Column="1"
				Text="{Binding Nickname}" />
			<Label
				Grid.Row="2"
				Grid.Column="0"
				Content="Website:" />
			<TextBox
				Grid.Row="2"
				Grid.Column="1"
				Text="{Binding WebsiteUrl}" />
			<Label
				Grid.Row="5"
				Grid.Column="0"
				Content="LogoName:" />
			<TextBox
				Grid.Row="5"
				Grid.Column="1"
				Text="{Binding LogoName}" />
			<Label
				Grid.Row="3"
				Grid.Column="0"
				Content="Arena:" />
			<TextBox
				Grid.Row="3"
				Grid.Column="1"
				Text="{Binding ArenaName}" />
			<Label
				Grid.Row="4"
				Grid.Column="0"
				Content="City:" />
			<TextBox
				Grid.Row="4"
				Grid.Column="1"
				Text="{Binding CityName}" />
			<Label
				Grid.Row="6"
				Grid.Column="0"
				Content="Description:" />
			<TextBox
				Grid.Row="6"
				Grid.Column="1"
				Text="{Binding Description}" />
			<Label
				Grid.Row="7"
				Grid.Column="0"
				Content="Logo:" />
			<Image
				Grid.Row="7"
				Grid.Column="1"
				Height="200"
				HorizontalAlignment="Left"
				VerticalAlignment="Top"
				d:Source="/Assets/DefaultLogo.gif"
				Source="{Binding LogoUri}" />
		</Grid>
		<Button
			Grid.Row="1"
			Grid.ColumnSpan="2"
			Margin="3"
			Background="Transparent"
			Command="{Binding CloseCommand}">
			<Image Height="50">
				<Image.Source>
					<BitmapImage UriSource="/Assets/GreenExitArrowRight.jpg" />
				</Image.Source>
			</Image>
		</Button>
	</Grid>
</Window>